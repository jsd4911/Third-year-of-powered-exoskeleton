/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_CAN1_Init();
  /* USER CODE BEGIN 2 */

  /* Accept all CAN IDs into FIFO0 (receive-only test). */
  CAN_FilterTypeDef filter = {0};
  filter.FilterBank = 0;
  filter.FilterMode = CAN_FILTERMODE_IDMASK;
  filter.FilterScale = CAN_FILTERSCALE_32BIT;
  filter.FilterIdHigh = 0;
  filter.FilterIdLow = 0;
  filter.FilterMaskIdHigh = 0;
  filter.FilterMaskIdLow = 0;
  filter.FilterFIFOAssignment = CAN_RX_FIFO0;
  filter.FilterActivation = ENABLE;
  filter.SlaveStartFilterBank = 14;

  if (HAL_CAN_ConfigFilter(&hcan1, &filter) != HAL_OK)
  {
    Error_Handler();
  }

  if (HAL_CAN_Start(&hcan1) != HAL_OK)
  {
    Error_Handler();
  }

  if (HAL_CAN_ActivateNotification(&hcan1,
          CAN_IT_RX_FIFO0_MSG_PENDING) != HAL_OK)
  {
    Error_Handler();
  }

  const char startup[] = "CAN RX Ready\r\n";
  HAL_UART_Transmit(&huart2, (uint8_t *)startup,
                    sizeof(startup) - 1, 100);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    if (can_rx_ready)
    {
      uint32_t id;
      uint32_t dlc;
      uint8_t data[8];

      __disable_irq();
      id = can_rx_id;
      dlc = can_rx_dlc;
      for (int i = 0; i < 8; i++)
      {
        data[i] = can_rx_data[i];
      }
      can_rx_ready = 0;
      __enable_irq();

      char msg[120];
      int len = snprintf(msg, sizeof(msg),
                         "CAN ID=0x%lX DLC=%lu DATA=",
                         (unsigned long)id,
                         (unsigned long)dlc);

      /* Max DLC for Classic CAN is eight bytes. */
      for (uint32_t i = 0; i < dlc && i < 8; i++)
      {
        len += snprintf(msg + len, sizeof(msg) - (size_t)len,
                        "%02X ", data[i]);
      }
      len += snprintf(msg + len, sizeof(msg) - (size_t)len,
                      "\r\n");

      HAL_UART_Transmit(&huart2, (uint8_t *)msg, (uint16_t)len, 100);
    }

    HAL_Delay(5);
  }
  /* USER CODE END 3 */
}


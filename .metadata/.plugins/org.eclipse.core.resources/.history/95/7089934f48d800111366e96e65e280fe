/* USER CODE BEGIN 4 */
void HAL_CAN_RxFifo0MsgPendingCallback(
    CAN_HandleTypeDef *hcan)
{
    if (hcan->Instance != CAN1)
        return;

    CAN_RxHeaderTypeDef header;
    uint8_t data[8];

    if (HAL_CAN_GetRxMessage(
            hcan,
            CAN_RX_FIFO0,
            &header,
            data) == HAL_OK)
    {
        can_rx_id = (header.IDE == CAN_ID_STD)
                    ? header.StdId
                    : header.ExtId;

        can_rx_dlc = header.DLC;

        for (int i = 0; i < 8; i++)
        {
            can_rx_data[i] = data[i];
        }

        can_rx_ready = 1;
    }
}


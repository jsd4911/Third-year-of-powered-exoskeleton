/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_CAN1_Init();
  /* USER CODE BEGIN 2 */
  /* Exact bxCAN 32-bit filter: Extended DATA ID == 0x2968, to FIFO0.
     29-bit ID is left-shifted 3; IDE bit=2 must be 1, RTR bit=1 must be 0.
     The mask checks all 29 identifier bits plus IDE and RTR. */
  CAN_FilterTypeDef filter = {0};
  const uint32_t eid = AK_CAN_FEEDBACK_ID;
  filter.FilterBank = 0;
  filter.FilterMode = CAN_FILTERMODE_IDMASK;
  filter.FilterScale = CAN_FILTERSCALE_32BIT;
  filter.FilterIdHigh = (uint16_t)(eid >> 13);
  filter.FilterIdLow = (uint16_t)((eid << 3) | 0x0004U);  /* IDE=1, RTR=0 */
  filter.FilterMaskIdHigh = 0xFFFFU;
  filter.FilterMaskIdLow = 0xFFFEU;
  filter.FilterFIFOAssignment = CAN_RX_FIFO0;
  filter.FilterActivation = ENABLE;
  filter.SlaveStartFilterBank = 14;

  if (HAL_CAN_ConfigFilter(&hcan1, &filter) != HAL_OK)
  {
    AK_UartLine("ERROR: CAN filter configuration failed\r\n");
    Error_Handler();
  }
  if (hcan1.Init.Mode != CAN_MODE_NORMAL)
  {
    AK_UartLine("ERROR: CAN1 must be NORMAL, not LOOPBACK\r\n");
    Error_Handler();
  }
  if (HAL_CAN_Start(&hcan1) != HAL_OK)
  {
    AK_UartLine("ERROR: CAN1 start failed\r\n");
    Error_Handler();
  }
  if (HAL_CAN_ActivateNotification(&hcan1,
          CAN_IT_RX_FIFO0_MSG_PENDING) != HAL_OK)
  {
    AK_UartLine("ERROR: RX0 notification failed\r\n");
    Error_Handler();
  }
  ak_start_ms = HAL_GetTick();
  AK_UartLine("AK10-9 CAN FEEDBACK MONITOR START\r\n");
  AK_UartLine("CAN EXT=0x2968 rate=1Mbps feedback=50Hz timeout=200ms TX=DISABLED\r\n");
/* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    AK_Feedback fb;
    uint32_t primask = __get_PRIMASK();
    __disable_irq();
    /* Short atomic copy: no printf, memory allocation or UART in IRQ. */
    fb.position_x10 = ak_rx.position_x10;
    fb.speed_x10_erpm = ak_rx.speed_x10_erpm;
    fb.current_x100 = ak_rx.current_x100;
    fb.temperature_c = ak_rx.temperature_c;
    fb.fault_code = ak_rx.fault_code;
    fb.last_rx_ms = ak_rx.last_rx_ms;
    fb.received = ak_rx.received;
    fb.rejected = ak_rx.rejected;
    fb.seen = ak_rx.seen;
    if (primask == 0U)
    {
      __enable_irq();
    }
    /* Read time AFTER snapshot: prevents a newer ISR timestamp appearing
       'in the future' relative to an earlier timestamp read in main(). */
    uint32_t now_ms = HAL_GetTick();

    AK_LinkState state = AK_GetLinkState(&fb, now_ms);
    static int32_t previous_state = -1;
    static int32_t previous_fault = -1;
    static uint32_t last_report_ms = 0U;
    char line[220];

    if ((int32_t)state != previous_state)
    {
      const char *event = "WAITING";
      if (state == AK_LINK_ONLINE)
        event = (previous_state == (int32_t)AK_LINK_TIMEOUT ||
                 previous_state == (int32_t)AK_LINK_NO_DATA) ? "RECOVERED" : "ONLINE";
      else if (state == AK_LINK_NO_DATA)
        event = "NO_DATA";
      else if (state == AK_LINK_TIMEOUT)
        event = "TIMEOUT: FEEDBACK INVALID";
      (void)snprintf(line, sizeof(line), "EVENT CAN %s\r\n", event);
      AK_UartLine(line);
      previous_state = (int32_t)state;
    }

    if (state == AK_LINK_ONLINE)
    {
      if (previous_fault != (int32_t)fb.fault_code)
      {
        (void)snprintf(line, sizeof(line), "EVENT DRIVE_FAULT=%u %s\r\n",
                       (unsigned int)fb.fault_code, AK_FaultName(fb.fault_code));
        AK_UartLine(line);
        previous_fault = (int32_t)fb.fault_code;
      }
    }
    else
    {
      previous_fault = -1; /* never label stale fault state as live */
    }

    if ((uint32_t)(now_ms - last_report_ms) >= AK_STATUS_PRINT_MS)
    {
      last_report_ms = now_ms;
      uint32_t esr = CAN1->ESR;
      uint32_t rec = (esr >> 24) & 0xFFU;
      uint32_t tec = (esr >> 16) & 0xFFU;
      if (state == AK_LINK_ONLINE)
      {
        char pos[20];
        char current[20];
        AK_FormatFixed(pos, sizeof(pos), fb.position_x10, 10U);
        AK_FormatFixed(current, sizeof(current), fb.current_x100, 100U);
        (void)snprintf(line, sizeof(line),
                       "FB ONLINE rx=%lu age=%lums pos=%sdeg speed=%ldERPM "
                       "current=%sA temp=%dC fault=%u(%s) bad=%lu REC=%lu TEC=%lu\r\n",
                       (unsigned long)fb.received,
                       (unsigned long)(now_ms - fb.last_rx_ms),
                       pos, (long)fb.speed_x10_erpm * 10L, current,
                       (int)fb.temperature_c,
                       (unsigned int)fb.fault_code, AK_FaultName(fb.fault_code),
                       (unsigned long)fb.rejected,
                       (unsigned long)rec, (unsigned long)tec);
      }
      else
      {
        const char *state_name = (state == AK_LINK_WAITING) ? "WAITING" :
                                 (state == AK_LINK_NO_DATA) ? "NO_DATA" : "TIMEOUT";
        (void)snprintf(line, sizeof(line),
                       "FB %s rx=%lu age=%lums DATA=INVALID bad=%lu "
                       "REC=%lu TEC=%lu HALerr=0x%08lX\r\n",
                       state_name, (unsigned long)fb.received,
                       (unsigned long)(fb.seen ? (now_ms - fb.last_rx_ms) :
                                       (now_ms - ak_start_ms)),
                       (unsigned long)fb.rejected,
                       (unsigned long)rec, (unsigned long)tec,
                       (unsigned long)HAL_CAN_GetError(&hcan1));
      }
      AK_UartLine(line);
    }
    HAL_Delay(5U);
  }
/* USER CODE END 3 */
}


/* USER CODE BEGIN 4 */
/* CAN interrupt: decode + timestamp, no blocking UART and no motor commands. */
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
  if (hcan->Instance != CAN1)
    return;

  while (HAL_CAN_GetRxFifoFillLevel(hcan, CAN_RX_FIFO0) > 0U)
  {
    CAN_RxHeaderTypeDef header;
    uint8_t data[8] = {0};
    if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &header, data) != HAL_OK)
    {
      ak_rx.rejected++;
      break;
    }
    if (header.IDE != CAN_ID_EXT || header.RTR != CAN_RTR_DATA ||
        header.ExtId != AK_CAN_FEEDBACK_ID || header.DLC != AK_CAN_EXPECTED_DLC)
    {
      ak_rx.rejected++;
      continue;
    }
    ak_rx.position_x10 = AK_ReadI16BE(&data[0]);
    ak_rx.speed_x10_erpm = AK_ReadI16BE(&data[2]);
    ak_rx.current_x100 = AK_ReadI16BE(&data[4]);
    ak_rx.temperature_c = (int8_t)data[6];
    ak_rx.fault_code = data[7];
    ak_rx.last_rx_ms = HAL_GetTick();
    ak_rx.received++;
    ak_rx.seen = 1U;
  }
}
/* USER CODE END 4 */


/* CubeMars servo-mode feedback (function ID 0x29; extended 29-bit ID). */
typedef struct
{
  int16_t position_x10;    /* signed, degrees x 10 */
  int16_t speed_x10_erpm;  /* signed, ERPM / 10 */
  int16_t current_x100;   /* signed, amperes x 100 */
  int8_t temperature_c;   /* feedback byte 6, signed C */
  uint8_t fault_code;     /* feedback byte 7 */
  uint32_t last_rx_ms;
  uint32_t received;
  uint32_t rejected;
  uint8_t seen;
} AK_Feedback;

typedef enum
{
  AK_LINK_WAITING = 0,
  AK_LINK_ONLINE,
  AK_LINK_NO_DATA,
  AK_LINK_TIMEOUT
} AK_LinkState;

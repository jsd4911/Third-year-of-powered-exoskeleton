/* Decode signed 16-bit big-endian values without depending on signed cast overflow. */
static int16_t AK_ReadI16BE(const uint8_t *p)
{
  uint16_t raw = (uint16_t)(((uint16_t)p[0] << 8) | p[1]);
  int32_t signed_value = (raw & 0x8000U) ? ((int32_t)raw - 65536L) : (int32_t)raw;
  return (int16_t)signed_value;
}

/* Integer-only fixed point output: avoids requiring -u _printf_float. */
static void AK_FormatFixed(char *dst, size_t dst_cap, int32_t value, uint32_t scale)
{
  uint32_t abs_value = (value < 0) ? (uint32_t)(-value) : (uint32_t)value;
  if (scale == 10U)
  {
    (void)snprintf(dst, dst_cap, "%s%lu.%01lu",
                   (value < 0) ? "-" : "",
                   (unsigned long)(abs_value / 10U),
                   (unsigned long)(abs_value % 10U));
  }
  else
  {
    (void)snprintf(dst, dst_cap, "%s%lu.%02lu",
                   (value < 0) ? "-" : "",
                   (unsigned long)(abs_value / 100U),
                   (unsigned long)(abs_value % 100U));
  }
}

/* UART is used ONLY from the main loop; never from the CAN ISR. */
static void AK_UartLine(const char *message)
{
  size_t len = strlen(message);
  if (len != 0U && len < 65536U)
  {
    (void)HAL_UART_Transmit(&huart2, (uint8_t *)message, (uint16_t)len, 100U);
  }
}

static AK_LinkState AK_GetLinkState(const AK_Feedback *fb, uint32_t now_ms)
{
  if (fb->seen == 0U)
  {
    return ((uint32_t)(now_ms - ak_start_ms) < AK_BOOT_GRACE_MS)
           ? AK_LINK_WAITING : AK_LINK_NO_DATA;
  }
  return ((uint32_t)(now_ms - fb->last_rx_ms) <= AK_RX_TIMEOUT_MS)
         ? AK_LINK_ONLINE : AK_LINK_TIMEOUT;
}

static const char *AK_FaultName(uint8_t fault)
{
  switch (fault)
  {
    case 0U: return "NONE";
    case 1U: return "MOTOR_OVER_TEMP";
    case 2U: return "OVER_CURRENT";
    case 3U: return "OVER_VOLTAGE";
    case 4U: return "UNDER_VOLTAGE";
    case 5U: return "ENCODER_FAULT";
    case 6U: return "MOS_OVER_TEMP";
    case 7U: return "MOTOR_STALL";
    default: return "OTHER_CODE";
  }
}
